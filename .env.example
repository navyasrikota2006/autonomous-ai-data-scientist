# Database Configuration
# Default is Local SQLite. Set for PostgreSQL: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://ml_user:ml_password@localhost:5432/ml_database

# Agent Orchestrator Call Mode: "openai", "gemini", "anthropic", or "none" (determins fallback metrics)
LLM_PROVIDER=none

# Provider Keys (only required if LLM_PROVIDER is not "none")
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optinal Overridden Models
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-1.5-flash
# LLM_MODEL=claude-3-haiku-20240307
